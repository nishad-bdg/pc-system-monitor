# MongoDB
SYSTEM_INFO_MONGO_URI=mongodb://localhost:27017
SYSTEM_INFO_MONGO_DB=system_info

# JWT auth (admin dashboard) - use a random 32+ char secret in production
JWT_SECRET=dev-only-secret-change-me-32bytes-min
JWT_EXPIRE_MINUTES=60

# Default admin user (seeded on startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin