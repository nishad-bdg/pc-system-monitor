# Base URL of the FastAPI backend (server-side NextAuth callback)
API_URL=http://127.0.0.1:8000

# Base URL of the FastAPI backend (client-side data fetch)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# NextAuth - generate via: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-byte-string
NEXTAUTH_URL=http://localhost:3000